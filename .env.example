# Copy to .env and fill in. Never commit .env.

# Postgres on the VPS
DATABASE_URL=postgres://jarvis:CHANGE_ME@localhost:5432/jarvis

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model for the coordinator. Sonnet is the cost-sensible default for a nightly run;
# switch to claude-opus-5-5 for deeper strategy sessions.
JARVIS_MODEL=claude-sonnet-5-5

# Used for "today" in the brief.
JARVIS_TIMEZONE=Europe/Lisbon
